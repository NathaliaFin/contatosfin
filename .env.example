# ---------------------------------------------------------------------------
# Sistema Contatos Fin
# Copie este arquivo para ".env" e preencha os valores reais.
# O arquivo .env NAO deve ser versionado.
# ---------------------------------------------------------------------------

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao

# development | production
FLASK_ENV=development

# --- Banco de dados -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=srvdb-web.mysql.database.azure.com
DB_PORT=3306
DB_DATABASE=contatosfin
DB_USERNAME=contatosfin
DB_PASSWORD=
DB_SSL=true
DB_SSL_CA=

# --- Dados restritos ------------------------------------------------------
# Gere UMA VEZ com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# e nunca mais troque (os dados gravados ficariam ilegiveis).
CHAVE_DADOS_RESTRITOS=

APP_URL=https://contatos.fin.org.br
FOTO_MAX_MB=5

# --- Administrador (comando "flask seed") ---------------------------------
ADMIN_EMAIL=
ADMIN_NOME=
ADMIN_SENHA=

# --- SSO Microsoft (Entra ID) ---------------------------------------------
SSO_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://contatos.fin.org.br/auth/sso/callback
SSO_DOMINIO=fin.org.br

# --- E-mail (SMTP Microsoft 365) ------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=contatos@fin.org.br
SMTP_PASSWORD=
SMTP_FROM=contatos@fin.org.br
SMTP_FROM_NAME=Contatos Fin

# --- Servidor de producao -------------------------------------------------
SERVER_HOST=172.16.0.12
SERVER_USER=azureuser
SERVER_KEY=..\SRVWEB-HUBRI_KEY.pem
